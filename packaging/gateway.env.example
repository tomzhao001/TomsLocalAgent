# TomsGateway 配置。install-service 会把本文件复制到用户数据目录：
#   Windows：%LOCALAPPDATA%\TomsGateway\gateway.env
#   macOS：~/Library/Application Support/TomsGateway/gateway.env

# 网页登录密码，必须改掉
ADMIN_PASSWORD=change-me

# Cursor Dashboard > Integrations 里创建的 User API Key，不填则 Cursor 模式不可用
CURSOR_API_KEY=

# 本机允许创建 workspace 的根目录，必须是真实的本机路径
# 多个目录：Windows 用 ; 分隔，macOS 用 : 分隔
# 例：WORKSPACE_ROOTS=D:\code;E:\projects      或      WORKSPACE_ROOTS=/Users/tom/code
WORKSPACE_ROOTS=

# 只监听本机，外部通过 tailscale serve 访问
HOST=127.0.0.1
PORT=3701

# 通过 tailscale serve 的 https 地址访问时保持 true。
# 只在本机用 http://127.0.0.1:3701 访问时改为 false，否则登录后 Cookie 保存不住。
COOKIE_SECURE=true

# OpenCode 模式。模型凭据先用 opencode-auth 登录一次，或在下面写 DEEPSEEK_API_KEY 之类的变量
OPENCODE_ENABLE=false
OPENCODE_PORT=3702
OPENCODE_SERVER_PASSWORD=change-me-too

# 留空则使用上面说明中的用户数据目录
DATA_DIR=
