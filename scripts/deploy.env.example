# 复制为本目录的 deploy.env 后再填写。deploy.env 含密码，不要提交。

# 例如 registry.cn-hangzhou.aliyuncs.com
ACR_REGISTRY=
ACR_NAMESPACE=
ACR_USERNAME=
ACR_PASSWORD=
ACR_IMAGE=toms-local-agent
ACR_TAG=latest

# 部署
CONTAINER_NAME=toms-gateway
HTTP_PORT=3000
# 留空则使用仓库下的 data 和 workspaces
DATA_HOST_DIR=
WORKSPACE_HOST_ROOT=
