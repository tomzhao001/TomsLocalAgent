# 本地调试用。安装包使用 gateway.env.example，内容相同。
ADMIN_PASSWORD=change-me
CURSOR_API_KEY=
# 本机允许创建 workspace 的根目录，多个用 ;（Windows）或 :（macOS）分隔
WORKSPACE_ROOTS=
# 留空则使用系统默认数据目录
DATA_DIR=
HOST=127.0.0.1
PORT=3701
# 通过 tailscale serve 走 HTTPS 时保持 true；本地用 http 调试时改为 false
COOKIE_SECURE=true
OPENCODE_ENABLE=false
OPENCODE_PORT=3702
OPENCODE_SERVER_PASSWORD=change-me-too
# 开发、DevOps 和拆卡使用的 Cursor 模型
WORKFLOW_MODEL=auto
# Review 使用的模型。留空则与 WORKFLOW_MODEL 相同
REVIEW_MODEL=
# 工作流调度的轮询间隔（毫秒），默认 60000
DISPATCH_INTERVAL_MS=60000
